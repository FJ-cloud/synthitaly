# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Virtual env
.venv/

# Jupyter
.ipynb_checkpoints/

# Notebook runtime artefacts (regenerated by Run All)
notebooks/demo.html
notebooks/demo_transactions.csv
notebooks/demo_accounts.csv

# Simulation outputs. Every run is local and regenerable, with one exception:
# runs/20260822-142420/ is the pinned run the thesis reports, named by Appendix
# C.5, so it is tracked. runs/latest is a real copy of it rather than a symlink:
# Appendix C.4 tells the reader to open runs/latest/results.html, and a symlink
# to a directory does not resolve when the repository is browsed on github.com.
# Re-running run_all.py replaces it locally with a symlink to the new run, which
# then shows up as a modified file.
runs/*
!runs/20260822-142420/
!runs/latest/

# Dataset exports — scripts/export_dataset.py writes here by default. Derived
# from a seeded model, so regenerable by re-running the command in MANIFEST.md.
exports/

# Derived artefacts — every one of these is regenerated by a committed script,
# so the script is the source of truth and the output does not belong in git.
#   presentation/scripts/generate_figures.py     -> figures/
#   presentation/scripts/make_overview_figure.py -> figures/f00_overview*
#   presentation/scripts/make_diagrams.py        -> diagrams/
#   presentation/scripts/make_slide_assets.py    -> slide_assets/
#   presentation/scripts/build_deck.py           -> status_deck.html
#   presentation/scripts/make_reference_card.py  -> MODEL_REFERENCE_CARD.pdf
#   presentation/scripts/make_system_sequence.py -> SLIDES/ (dupes of slide_assets)
#
# thesis_package/ is the exception. scripts/build_thesis_package.py regenerates
# it, but Appendix C.4 of the thesis tells the reader to open
# thesis_package/index.html without rerunning the model, so it is tracked.
presentation/figures/
presentation/diagrams/
presentation/slide_assets/
presentation/status_deck.html
presentation/MODEL_REFERENCE_CARD.pdf
SLIDES/

# Slide decks — large binaries, not diffable, not part of the codebase.
*.pptx

# Archives
*.zip

# Local agent/editor state
.claude/

# OS
.DS_Store
